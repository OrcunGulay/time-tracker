# ---- Sunucu ----
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

# ---- Veritabani (yerel PostgreSQL 17) ----
DATABASE_URL=postgresql://orcungulay@localhost:5432/timetracker
DATABASE_SSL=false
PG_POOL_MAX=10

# ---- JWT ----
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=900          # saniye (15 dk)
JWT_REFRESH_TTL=2592000     # saniye (30 gun)
# Zorunlu: varsayilan parolalar prod'da reddedilir
ALLOW_INSECURE_JWT_SECRETS=false

# ---- S3 / MinIO ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=screenshots
S3_ACCESS_KEY_ID=ttadmin
S3_SECRET_ACCESS_KEY=ttadmin123
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL=900
# Public okuma icin CDN/base URL (bos ise presigned GET uretilir)
S3_PUBLIC_BASE_URL=

# ---- Is kurallari ----
# Sirket/varsayilan saat dilimi: rapor ve bordro donemleri bu dilimde yorumlanir
DEFAULT_TIMEZONE=Europe/Istanbul
# Uretkenlik skorunda NEUTRAL kategorisinin payi (0-1)
PRODUCTIVITY_NEUTRAL_WEIGHT=0
# Idle esigi (saniye) - agent ile ayni olmali
IDLE_THRESHOLD_SECONDS=180
# Ekran goruntusu silindiginde mesai suresinden dusulecek blok (saniye)
SCREENSHOT_BLOCK_SECONDS=600

# ---- Google Drive & Koç Hakediş Entegrasyonu ----
# Google Cloud Service Account e-posta adresi
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Google Cloud Service Account gizli anahtarı (özel anahtar / PEM formatında, \n kaçışları korunmalı)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
# Google Drive'daki "Koçlar" ana klasörünün ID'si
GOOGLE_DRIVE_COACHES_FOLDER_ID=1A2B3C4D5E6F7G8H9I0J_EXAMPLE_FOLDER_ID

