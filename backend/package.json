{
  "name": "@timetracker/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "test": "node --import tsx --import ./src/test/env.mjs --test --test-reporter=spec \"src/**/*.test.ts\"",
    "test:watch": "node --import tsx --import ./src/test/env.mjs --test --watch \"src/**/*.test.ts\"",
    "test:integration": "node --import tsx --import ./src/test/env.mjs --test --test-reporter=spec \"src/**/*.integration.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "@aws-sdk/s3-request-presigner": "^3.658.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^10.1.1",
    "adm-zip": "^0.6.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "googleapis": "^184.0.0",
    "pdfkit": "^0.15.0",
    "pg": "^8.13.1",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.7.4",
    "@types/pdfkit": "^0.13.5",
    "@types/pg": "^8.11.10",
    "pino-pretty": "^11.3.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
